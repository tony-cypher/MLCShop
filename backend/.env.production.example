# ---------------------------------------------------------------------------
# MLC API — production environment (Render)
# Every value below is set in the Render dashboard (Environment tab).
# `render.yaml` already declares these keys, so you only fill the secrets.
#
# URL handling: FRONTEND_URL is the one host you MUST set (it drives CORS, the
# OAuth redirect back to the SPA and email links). APP_URL and GOOGLE_REDIRECT_URI
# are OPTIONAL — the API auto-detects its own URL from RENDER_EXTERNAL_URL and
# derives the Google callback from it. Set them only for a custom domain.
# ---------------------------------------------------------------------------

APP_NAME=MLC
APP_ENV=production
APP_DEBUG=false
APP_URL=                                         # blank -> RENDER_EXTERNAL_URL (recommended)

FRONTEND_URL=https://your-app.vercel.app         # REQUIRED: your Vercel URL
# CORS_ALLOWED_ORIGINS=                          # optional extra origins, comma-separated
# CORS_ALLOWED_ORIGINS_PATTERNS=                 # optional regexes, comma-separated

LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Supabase Postgres — Project Settings -> Database -> Connection string.
# On Render prefer the SESSION POOLER: host aws-0-<region>.pooler.supabase.com,
# user postgres.<project-ref>.
# ---------------------------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=aws-0-<region>.pooler.supabase.com
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres.<project-ref>
DB_PASSWORD=<your-database-password>
DB_SSLMODE=require

# Alternatively, paste a single connection string; it overrides the DB_* values.
# DATABASE_URL=postgresql://postgres.<ref>:<password>@<host>:5432/postgres?sslmode=require

# Set true for ONE deploy to seed the catalogue, then set back to false.
RUN_SEED=false

# ---------------------------------------------------------------------------
# Resend — set MAIL_MAILER=resend and supply your RESEND_API_KEY.
# ---------------------------------------------------------------------------
MAIL_MAILER=log                  # switch to "resend" for real delivery
# RESEND_API_KEY=re_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
MAIL_FROM_ADDRESS=onboarding@resend.dev  # or your verified domain e.g. no-reply@yourdomain.com
MAIL_FROM_NAME=MLC

# ---------------------------------------------------------------------------
# Google OAuth — in console.cloud.google.com add the callback that this service
# will use to the OAuth client's Authorized redirect URIs:
#   https://<your-service>.onrender.com/api/auth/google/callback
# Then set GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET below. Leave
# GOOGLE_REDIRECT_URI blank so it is derived automatically, unless you use a
# custom domain — in which case it must exactly match a registered URI.
# ---------------------------------------------------------------------------
# GOOGLE_CLIENT_ID=1234567890-xxxxxxxx.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxxxxxx
# GOOGLE_REDIRECT_URI=                            # blank -> <service URL>/api/auth/google/callback
