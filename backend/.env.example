# ---------------------------------------------------------------------------
# MLC API — local development environment
# Copy to .env (Windows: `copy .env.example .env`). No values are required to
# boot: without any of these the API uses SQLite and the "log" mail driver.
# ---------------------------------------------------------------------------

APP_NAME=MLC
APP_ENV=local
APP_DEBUG=true

# Public URL of this API and of the React app. Both are OPTIONAL: when left
# blank the API auto-detects its own URL (RENDER_EXTERNAL_URL on Render) and the
# frontend origin from the browser request. Set them explicitly in production.
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

# Optional extra CORS origins (comma-separated) and regex patterns.
# CORS_ALLOWED_ORIGINS=
# CORS_ALLOWED_ORIGINS_PATTERNS=

LOG_LEVEL=info

# Local default: SQLite file (works out of the box, no services needed).
# DATABASE_URL=

# ---------------------------------------------------------------------------
# Supabase Postgres (Project Settings -> Database -> Connection string)
# Set DB_CONNECTION=pgsql and fill the values below (or set DATABASE_URL).
# Prefer the Session pooler host from Render — direct db.<ref>.supabase.co
# can be IPv6-only.
# ---------------------------------------------------------------------------
DB_CONNECTION=sqlite
# DB_CONNECTION=pgsql
# DB_HOST=aws-0-eu-west-2.pooler.supabase.com
# DB_PORT=5432
# DB_DATABASE=postgres
# DB_USERNAME=postgres.YOUR-PROJECT-REF
# DB_PASSWORD=YOUR-DATABASE-PASSWORD
# DB_SSLMODE=require

# Seed the catalogue once on boot, then set back to false.
RUN_SEED=false

# Development: emails are written to the application log instead of being sent.
MAIL_MAILER=log

# ---------------------------------------------------------------------------
# Resend (resend.com -> API Keys / Domains)
# Set MAIL_MAILER=resend and supply your RESEND_API_KEY.
# ---------------------------------------------------------------------------
# MAIL_MAILER=resend
# RESEND_API_KEY=re_123456789_abcdefghijklmnopqrstuvwxyz
MAIL_FROM_ADDRESS=onboarding@resend.dev
MAIL_FROM_NAME=MLC

# ---------------------------------------------------------------------------
# Google sign-in (console.cloud.google.com -> APIs & Services -> Credentials)
# Create an OAuth client of type "Web application" with:
#   Authorized redirect URI: http://localhost:8000/api/auth/google/callback
# GOOGLE_REDIRECT_URI is OPTIONAL — leave it blank and the API derives the
# callback from APP_URL. Only set it to override (e.g. a custom domain).
# ---------------------------------------------------------------------------
# GOOGLE_CLIENT_ID=1234567890-xxxxxxxx.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxxxxxx
# GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
